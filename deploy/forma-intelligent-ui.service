[Unit]
Description=Forma Intelligent UI authenticated streaming API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=forma
Group=forma
WorkingDirectory=/opt/forma-intelligent-ui
EnvironmentFile=/etc/forma-intelligent-ui.env
ExecStart=/usr/bin/node /opt/forma-intelligent-ui/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=512M
UMask=0077

[Install]
WantedBy=multi-user.target
